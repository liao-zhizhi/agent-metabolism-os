# Build context is this directory, and Hugging Face uploads it as the Space repo.
# Keeping the context small keeps the Space push fast and the image honest about
# what it actually needs.

.venv
.venv/
**/__pycache__
**/*.pyc
.pytest_cache
tests
assets
*.md
docker-compose.yml

# The core snapshot is a build-time input, not part of the app tree. Keep the
# docs out of the image; the package itself must come through when present.
core_snapshot/**/*.md
